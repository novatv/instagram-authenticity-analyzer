{
  "name": "instagram-authenticity-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Estimated Instagram audience & engagement authenticity analyzer. Never presents estimates as facts.",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "report": "esbuild scripts/render-report.tsx --bundle --platform=node --format=cjs --jsx=automatic --packages=external --alias:@=./src --outfile=.tmp/render-report.cjs --log-level=warning && node .tmp/render-report.cjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
