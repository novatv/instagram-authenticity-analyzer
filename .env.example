# ─────────────────────────────────────────────────────────────
# Instagram Authenticity Analyzer — environment
# Copy to .env.local. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Which data provider the backend uses.
#   mock        → built-in DEMO DATA (synthetic, clearly labelled). Default.
#   meta-graph  → Meta Graph API (Instagram Graph API, Business Discovery).
#                 Requires an Instagram Professional account + Facebook Page +
#                 an app with instagram_basic / business_management permissions.
INSTAGRAM_PROVIDER=mock

# Meta Graph API (only used when INSTAGRAM_PROVIDER=meta-graph)
META_GRAPH_ACCESS_TOKEN=
# Instagram Business Account ID that owns the token (used for business_discovery)
META_IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0

# Upload limits for the Import Data mode
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=50000

# Optional: JSON object overriding follower-suspicion feature weights.
# Example: {"ratioAnomaly":2.5,"usernamePattern":0.5}
SUSPICION_WEIGHTS_JSON=
